# Zerum v0.2.0 example configuration
# Copy to zerum.toml and adjust for your project.
# Run: zerum init

[profile]
name = "default"

# --- Readability (ZR001–ZR015) ---

[checks.ZR001]
enabled = true
max_lines = 50

[checks.ZR002]
enabled = true
max_arguments = 5

[checks.ZR003]
enabled = true
max_depth = 3

[checks.ZR004]
enabled = true

[checks.ZR005]
enabled = true

[checks.ZR006]
enabled = true

[checks.ZR007]
enabled = true

[checks.ZR008]
enabled = true

[checks.ZR009]
enabled = true

[checks.ZR010]
enabled = true

# --- Consistency (ZR101–ZR110) ---
# Heuristic naming/style rules; disable noisy ids as needed.

[checks.ZR105]
enabled = true

[checks.ZR106]
enabled = true

# --- Design (ZR201–ZR210) ---

[checks.ZR201]
enabled = true
max_methods = 15

[checks.ZR205]
enabled = true

[checks.ZR207]
enabled = true

[[checks.ZR207.rules]]
from = "app.domain"
forbidden = "app.infrastructure"

[[checks.ZR207.rules]]
from = "app.domain"
forbidden = "app.api"

# --- Refactor (ZR301–ZR315) ---

[checks.ZR301]
enabled = true

[checks.ZR302]
enabled = true

[checks.ZR303]
enabled = true

[checks.ZR304]
enabled = true

[checks.ZR307]
enabled = true
max_arguments = 7

[checks.ZR310]
enabled = true

[checks.ZR314]
enabled = true

[checks.ZR315]
enabled = true

# --- Warning (ZR401–ZR415) ---

[checks.ZR401]
enabled = true
severity = "high"

[checks.ZR402]
enabled = true

[checks.ZR403]
enabled = true

[checks.ZR404]
enabled = true

[checks.ZR405]
enabled = true

[checks.ZR406]
enabled = true

[checks.ZR407]
enabled = true

[checks.ZR408]
enabled = true

[checks.ZR409]
enabled = true

[checks.ZR411]
enabled = true

[checks.ZR412]
enabled = true

[checks.ZR414]
enabled = true

[checks.ZR415]
enabled = true

# --- AI slop (ZR501–ZR510), deterministic only ---

[checks.ZR501]
enabled = true

[checks.ZR502]
enabled = true

[checks.ZR507]
enabled = true

# Disable a rule entirely:
# [checks.ZR110]
# enabled = false
